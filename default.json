{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":separateMultipleMajorReleases",
    "schedule:weekly",
    ":timezone(Europe/Paris)"
  ],
  "minimumReleaseAge": "7 days",
  "platformAutomerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 3,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": { "enabled": false },
  "packageRules": [
    {
      "description": "Automerge patch des deps de prod (hors 0.x)",
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Automerge minor+patch des devDependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Majeures : approbation via le Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "labels": ["major"]
    },
    {
      "description": "Coeur framework : jamais d automerge",
      "matchPackageNames": ["next", "react", "react-dom", "prisma", "@prisma/client"],
      "automerge": false
    },
    {
      "description": "Groupe NestJS",
      "matchPackageNames": ["@nestjs/**"],
      "groupName": "NestJS"
    },
    {
      "description": "Groupe Prisma",
      "matchPackageNames": ["prisma", "@prisma/client"],
      "groupName": "Prisma"
    }
  ]
}
